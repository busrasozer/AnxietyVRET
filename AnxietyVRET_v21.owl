  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#Scenario_Trigger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Scenario_Trigger</rdfs:label>
    <rdfs:comment>Alias for Scenario_Target (used to represent triggers such as Uncertainty, Time_Pressure, Unexpected_Event).</rdfs:comment>
    <owl:equivalentClass rdf:resource="http://example.org/anxiety-vret#Scenario_Target"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#PQ_Scale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PQ_Scale</rdfs:label>
    <rdfs:comment>Presence Questionnaire (PQ) scale used post-session (optional).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/anxiety-vret#Survey_Scale"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#scheduledAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>scheduledAt</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#Appointment"/>
