    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>Stage_1_Baseline</rdfs:label>
    <rdfs:comment>Baseline familiarization: neutral environment; used to observe baseline HR/HRV and exploration patterns.</rdfs:comment>
    <ns1:hasStageOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns1:hasStageOrder>
  </rdf:Description>
