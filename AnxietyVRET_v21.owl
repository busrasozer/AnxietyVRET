  <rdf:Description rdf:about="http://example.org/anxiety-vret#changeTimestamp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>changeTimestamp</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#Adaptation_History"/>
