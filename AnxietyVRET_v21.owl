  <rdf:Description rdf:about="http://example.org/anxiety-vret#baselineHeartRate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>baselineHeartRate</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#Patient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>Patient-specific resting heart rate (baseline) used for relative-threshold safety detection.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#analyzesDataFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>analyzesDataFrom</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#Analysis_Report"/>
    <rdfs:range rdf:nodeID="Nffa75d7cdb0a4467a7cd063bba3a53cd"/>
