    <rdfs:label>SubjectiveResponse</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://example.org/anxiety-vret#Response"/>
    <rdfs:comment>Subjective response (e.g., SUD score reported by participant).</rdfs:comment>
  </rdf:Description>
