    <rdfs:comment>Stage context in which the event occurred.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#VR_Event"/>
    <rdfs:range rdf:resource="http://example.org/anxiety-vret#Scenario_Stage"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#Confidence_Threshold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Confidence_Threshold</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#ML_Algorithm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
