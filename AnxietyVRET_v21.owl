  <rdf:Description rdf:about="http://example.org/anxiety-vret#observationTimestamp">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>observationTimestamp</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#Physiological_Data"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#Correlation_Analysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/anxiety-vret#Statistical_Method"/>
    <rdfs:label>Correlation_Analysis</rdfs:label>
    <rdfs:comment>Used for CQ6 (physiology/behavior vs. GAD-7 correlation analysis).</rdfs:comment>
    <ns1:methodName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Correlation</ns1:methodName>
    <ns1:methodPurpose rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Assess linear association between variables</ns1:methodPurpose>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#Stage5_RepetitionLoop">
    <rdf:type rdf:resource="http://example.org/anxiety-vret#Scenario_Stage"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>Stage_5_RepetitionLoop</rdfs:label>
    <rdfs:comment>Repetitive cognitive loop; avoidance/withdrawal behaviors may occur (e.g., going to bathroom or kitchen) without providing relaxation instructions.</rdfs:comment>
    <ns1:hasStageOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</ns1:hasStageOrder>
    <ns1:triggeredByContext rdf:resource="http://example.org/anxiety-vret#Context_AmericanKitchen"/>
    <ns1:triggeredByContext rdf:resource="http://example.org/anxiety-vret#Context_Bathroom"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#generates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>generates</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#ML_Algorithm"/>
    <rdfs:range rdf:resource="http://example.org/anxiety-vret#Prediction_Result"/>
    <owl:inverseOf rdf:resource="http://example.org/anxiety-vret#generatedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#fps">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>fps</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#Performance_Metric"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#hasTrigger">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasTrigger</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#VR_Scenario"/>
    <rdfs:range rdf:resource="http://example.org/anxiety-vret#Scenario_Target"/>
    <rdfs:comment>CQ8</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/anxiety-vret#eventPayloadJson">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>eventPayloadJson</rdfs:label>
    <rdfs:comment>Raw JSON payload string for forward compatibility.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/anxiety-vret#VR_Event"/>
